DISCORD_APPLICATION_ID=1572302708419985518
DISCORD_GUILD_ID=1572300706478817441
# Docker Compose reads the bot token from this file.
DISCORD_TOKEN_FILE_HOST=./.secrets/discord_token.txt
# Shared secret between the backend and the bot for paper-trading operator endpoints
# (pause/resume and the Discord outbox). Create it with:  openssl rand -hex 32 > .secrets/paper_operator_token.txt
PAPER_OPERATOR_TOKEN_FILE_HOST=./.secrets/paper_operator_token.txt
# Paper strategy settings can be overridden with NFL_PAPER_<FIELD>, e.g. NFL_PAPER_HOLD_POLICY=PREGAME_ONLY
